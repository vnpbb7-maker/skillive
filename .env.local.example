# Zoho Mail SMTP Settings
ZOHO_MAIL_USER=your_zoho_email@example.com
ZOHO_MAIL_PASS=your_zoho_password
ZOHO_MAIL_TO=recipient@example.com

# Optional: Vercel deployment URL
NEXT_PUBLIC_SITE_URL=https://www.skillive.com

# Stripe (GPUハードウェア - ノートPC販売)
# https://dashboard.stripe.com/apikeys から取得（本番は sk_live_... 、テストは sk_test_...）
STRIPE_SECRET_KEY=sk_test_your_secret_key
